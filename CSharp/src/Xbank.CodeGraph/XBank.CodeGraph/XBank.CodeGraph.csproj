<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XBank.CodeGraph</AssemblyName>
    <RootNamespace>XBank.CodeGraph</RootNamespace>
    <!-- الزامی: جلوگیری از کپی شدن اسمبلی‌های MSBuild در خروجی -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBank.CodeGraph.Contracts\XBank.CodeGraph.Contracts.csproj" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Data.Sqlite" VersionOverride="8.0.10" />
  </ItemGroup>

</Project>
