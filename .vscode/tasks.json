{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-csharp-debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CSharp/Maf.HandoffWorkflow.slnx",
