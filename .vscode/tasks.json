{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-csharp-release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CSharp/src/Maf.Handoff.Api/Maf.Handoff.Api.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-csharp-debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CSharp/src/Maf.Handoff.Api/Maf.Handoff.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
