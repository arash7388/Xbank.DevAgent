# Microsoft Foundry project endpoint (V2), for example:
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4.1

# Authentication: "cli" for local development, "managed_identity" in Azure.
AZURE_CREDENTIAL=cli
AZURE_CLIENT_ID=

# Orchestration safety limits.
MAF_MAX_TOTAL_MESSAGES=40
MAF_MAX_AGENT_TURNS=6
MAF_LOG_LEVEL=INFO

